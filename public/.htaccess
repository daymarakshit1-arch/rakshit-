# ====================================================================
# HOSTINGER WEB HOSTING CONFIGURATION (.htaccess)
# Designed for LiteSpeed & Apache on Hostinger hPanel / cPanel
# ====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ------------------------------------------------------------------
  # 1. SSL HTTPS ENFORCEMENT (Optional - recommended for Hostinger)
  # ------------------------------------------------------------------
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ------------------------------------------------------------------
  # 2. REST API ROUTING FOR HOSTINGER SHARED HOSTING
  # Maps clean REST URLs to the PHP API handlers in /api/
  # ------------------------------------------------------------------
  RewriteRule ^api/chat/?$ api/chat.php [QSA,L]
  RewriteRule ^api/products/?$ api/products.php [QSA,L]
  RewriteRule ^api/leads/?$ api/leads.php [QSA,L]
  RewriteRule ^api/health/?$ api/health.php [QSA,L]

  # ------------------------------------------------------------------
  # 3. STATIC FILES & DIRECTORIES
  # If the requested asset exists, serve it directly without rewrites
  # ------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ------------------------------------------------------------------
  # 4. SINGLE PAGE APPLICATION (SPA) FALLBACK
  # Route all other frontend navigation requests to index.html
  # ------------------------------------------------------------------
  RewriteRule ^ index.html [L]
</IfModule>

# --------------------------------------------------------------------
# 5. SECURITY HEADERS & DIRECTORY PROTECTION
# --------------------------------------------------------------------
Options -Indexes

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block access to hidden, environment, and configuration files
<FilesMatch "^\.(env|git|ht|config)">
  Order allow,deny
  Deny from all
</FilesMatch>

# --------------------------------------------------------------------
# 6. BROWSER CACHING (LiteSpeed / Apache Performance on Hostinger)
# --------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# --------------------------------------------------------------------
# 7. GZIP & BROTLI COMPRESSION
# --------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>
